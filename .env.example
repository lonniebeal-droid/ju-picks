# JU PICKS environment — VARIABLE NAMES ONLY. Never commit secrets.
NODE_ENV=development

# Auth
# Synthetic/dev auth only when NODE_ENV!==production AND this is true
JU_PICKS_DEV_AUTH=false

# Product hard gate — must remain false for MVP
REAL_MONEY_ENABLED=false

# Sports provider: mock | (future vendor id)
# Mock only allowed when NODE_ENV!==production
JU_PICKS_SPORTS_PROVIDER=mock

# --- Database (server-only) ---
# Local / CI disposable Postgres (never production):
#   DATABASE_URL=postgres://jupicks:jupicks@localhost:5432/jupicks_dev
# Apply migrations: npm run migrate
# Integration tests:   npm run test:db
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase (server-side only — never expose service role to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Settlement adapter activates only when a DbClient is registered
# with an authoritative server DATABASE_URL / service connection.
# Missing DB => fail-closed UnconfiguredSettlementAdapter.

# Optional future sports vendor credentials (unused until configured)
JU_PICKS_SPORTS_API_KEY=
JU_PICKS_SPORTS_API_URL=

# Force DB integration tests to fail when DATABASE_URL missing (CI sets this)
# JP_REQUIRE_DB=true
