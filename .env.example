# JU PICKS Environment Configuration

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Application Configuration
NODE_ENV=development

# Dev Auth Configuration (Batch 4 hardening)
# IMPORTANT: Only enable in development, NEVER in production
# Fake auth may only exist when NODE_ENV !== 'production' AND JU_PICKS_DEV_AUTH=true
JU_PICKS_DEV_AUTH=false

# REAL_MONEY_ENABLED must always be false for JU PICKS
REAL_MONEY_ENABLED=false

# Better Auth Configuration (if using Better Auth)
BETTER_AUTH_SECRET=your_better_auth_secret
DATABASE_URL=your_database_url

# Application Settings
PORT=3000
